{
  "name": "oxidevm-pyodide",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "oxidevm wasm build",
    "check": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p scripts && eslint . --max-warnings 0 && oxidevm wasm build --check",
    "fetch-upstream": "node scripts/fetch-upstream.ts",
    "notices": "node scripts/generate-notices.ts",
    "release": "oxidevm wasm release",
    "test": "vitest run",
    "test:conformance": "oxidevm wasm build && oxidevm wasm test",
    "test:browser": "node test/browser/harness.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@oxidevm/cli": "0.0.8",
    "@oxidevm/sdk": "0.0.8",
    "@types/emscripten": "1.41.6",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "playwright-core": "1.61.1",
    "pyodide": "314.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
